# Milkore API configuration. Copy to .env and fill in. Never commit .env.
# Every variable is validated at startup (src/config/env.validation.ts); the app refuses to start on a bad value.

NODE_ENV=development
PORT=3000
API_PUBLIC_URL=http://localhost:3000
# Comma-separated origins allowed to call the API from a browser (the admin dashboard).
CORS_ORIGINS=http://localhost:3001
# LOG_LEVEL=debug

# PostgreSQL 15+ with the PostGIS, pg_trgm and pgcrypto extensions available.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/milkore

# Secrets: generate each with  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-app-access-token-secret
REFRESH_TOKEN_PEPPER=change-me-refresh-token-pepper
ADMIN_JWT_SECRET=change-me-admin-token-secret
OTP_HMAC_SECRET=change-me-otp-hmac-secret
# JWT_ACCESS_TTL_SECONDS=900
# REFRESH_TTL_DAYS=30
# ADMIN_ACCESS_TTL_SECONDS=1800

# SMS: "console" logs OTPs (development only; refused in production). "msg91" needs DLT approval.
SMS_PROVIDER=console
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=

# Fixed OTP for app-store reviewers / QA. Keep disabled unless needed.
OTP_TEST_ENABLED=false
# OTP_TEST_PHONES=+919000000001
# OTP_TEST_CODE=246810
# Development only: the same OTP for every phone (SMS_PROVIDER=console). Refused in production.
OTP_DEV_STATIC_CODE=234567

# Photos: "local" writes to ./uploads (development); "s3" uses presigned uploads.
STORAGE_PROVIDER=local
AWS_REGION=ap-south-1
# S3_BUCKET=milkore-media-prod
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# MEDIA_PUBLIC_BASE_URL=https://cdn.milkore.in

# Location data (both free; see docs/DECISIONS.md ADR-003 and ADR-011).
PINCODE_API_URL=https://api.postalpincode.in
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=Milkore/1.0 (+support@milkore.in)

# First super admin created by `npm run db:seed` (only if it does not exist yet).
SEED_ADMIN_EMAIL=admin@milkore.local
SEED_ADMIN_PASSWORD=change-me-at-least-10-chars

# Development seed (`npm run seed:dev`, refuses to run in production).
DEV_SEED_LAT=28.6139
DEV_SEED_LNG=77.2090
PILOT_PINCODES=110001,110002,110003
