// Milkore database schema. Migrations only: `prisma migrate dev --create-only`, review, then apply.
// Never `migrate reset` or `db push`. Tables are snake_case, fields camelCase.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pg_trgm, pgcrypto]
}

// ───────────────────────────── D1: identity, auth, audit ─────────────────────────────

enum UserRole {
  CUSTOMER
  VENDOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum Language {
  en
  hi
}

enum OtpPurpose {
  LOGIN
}

enum AdminRole {
  SUPER_ADMIN
  MODERATOR
}

enum AdminStatus {
  ACTIVE
  DISABLED
}

enum ActorType {
  USER
  ADMIN
  SYSTEM
}

/// A person using the mobile app. Identity = verified mobile number (E.164).
model User {
  id                String     @id @default(uuid()) @db.Uuid
  phone             String     @unique @db.VarChar(16)
  name              String?    @db.VarChar(80)
  role              UserRole   @default(CUSTOMER)
  status            UserStatus @default(ACTIVE)
  preferredLanguage Language   @default(en) @map("preferred_language")
  lastLoginAt       DateTime?  @map("last_login_at")
  deletedAt         DateTime?  @map("deleted_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  sessions        RefreshSession[]
  customerProfile CustomerProfile?
  vendorProfile   VendorProfile?
  mediaAssets     MediaAsset[]

  @@index([role, status])
  @@map("users")
}

/// One OTP sent to a phone. Only the HMAC hash is stored.
model OtpRequest {
  id         String     @id @default(uuid()) @db.Uuid
  phone      String     @db.VarChar(16)
  otpHash    String     @map("otp_hash") @db.VarChar(128)
  purpose    OtpPurpose @default(LOGIN)
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at")
  consumedAt DateTime?  @map("consumed_at")
  ipAddress  String?    @map("ip_address") @db.VarChar(64)
  deviceId   String?    @map("device_id") @db.VarChar(128)
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([phone, createdAt])
  @@index([ipAddress, createdAt])
  @@map("otp_requests")
}

/// Rotating refresh token. `familyId` links a rotation chain so reuse revokes the whole chain.
model RefreshSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(128)
  familyId     String    @map("family_id") @db.Uuid
  deviceId     String?   @map("device_id") @db.VarChar(128)
  userAgent    String?   @map("user_agent") @db.VarChar(256)
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  lastUsedAt   DateTime? @map("last_used_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_sessions")
}

/// Customer-only data. The saved location is optional (manual PIN selection may have no coordinates).
model CustomerProfile {
  id           String                                 @id @default(uuid()) @db.Uuid
  userId       String                                 @unique @map("user_id") @db.Uuid
  location     Unsupported("geography(Point, 4326)")?
  addressLabel String?                                @map("address_label") @db.VarChar(160)
  pincode      String?                                @db.Char(6)
  city         String?                                @db.VarChar(80)
  createdAt    DateTime                               @default(now()) @map("created_at")
  updatedAt    DateTime                               @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

/// Dashboard user. Completely separate from app users and their tokens.
model AdminUser {
  id               String      @id @default(uuid()) @db.Uuid
  email            String      @unique @db.VarChar(120)
  name             String      @db.VarChar(80)
  passwordHash     String      @map("password_hash") @db.VarChar(100)
  role             AdminRole   @default(MODERATOR)
  status           AdminStatus @default(ACTIVE)
  totpSecret       String?     @map("totp_secret") @db.VarChar(64)
  failedLoginCount Int         @default(0) @map("failed_login_count")
  lockedUntil      DateTime?   @map("locked_until")
  lastLoginAt      DateTime?   @map("last_login_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  sessions AdminSession[]

  @@map("admin_users")
}

model AdminSession {
  id           String    @id @default(uuid()) @db.Uuid
  adminId      String    @map("admin_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(128)
  familyId     String    @map("family_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([familyId])
  @@map("admin_sessions")
}

/// Append-only record of security-relevant and admin actions.
model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id") @db.Uuid
  action     String    @db.VarChar(64)
  entityType String    @map("entity_type") @db.VarChar(40)
  entityId   String?   @map("entity_id") @db.VarChar(64)
  metadata   Json?
  ip         String?   @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ───────────────────────────── D2: vendors, locations, service areas, media ─────────────────────────────

enum VendorApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ServiceAreaType {
  RADIUS
  PINCODE
  LOCALITY
}

enum MediaPurpose {
  VENDOR_PROFILE
  VENDOR_SHOP
  PRODUCT
}

enum MediaStatus {
  PENDING_UPLOAD
  READY
  REJECTED
}

enum PincodeLookupStatus {
  FOUND
  NOT_FOUND
}

/// A seller's business profile. Exists from the first onboarding step (DRAFT).
model VendorProfile {
  id                String               @id @default(uuid()) @db.Uuid
  userId            String               @unique @map("user_id") @db.Uuid
  businessName      String?              @map("business_name") @db.VarChar(100)
  ownerName         String?              @map("owner_name") @db.VarChar(80)
  description       String?              @db.VarChar(500)
  /// Weekly hours: { mon: { open, close, closed }, ... }
  operatingHours    Json?                @map("operating_hours")
  approvalStatus    VendorApprovalStatus @default(DRAFT) @map("approval_status")
  rejectionReason   String?              @map("rejection_reason") @db.VarChar(300)
  suspensionReason  String?              @map("suspension_reason") @db.VarChar(300)
  onboardingStep    Int                  @default(0) @map("onboarding_step")
  isAvailable       Boolean              @default(true) @map("is_available")
  contactPhone      String?              @map("contact_phone") @db.VarChar(16)
  profilePhotoId    String?              @unique @map("profile_photo_id") @db.Uuid
  shopPhotoId       String?              @unique @map("shop_photo_id") @db.Uuid
  submittedAt       DateTime?            @map("submitted_at")
  approvedAt        DateTime?            @map("approved_at")
  approvedByAdminId String?              @map("approved_by_admin_id") @db.Uuid
  deletedAt         DateTime?            @map("deleted_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  profilePhoto    MediaAsset?             @relation("VendorProfilePhoto", fields: [profilePhotoId], references: [id], onDelete: SetNull)
  shopPhoto       MediaAsset?             @relation("VendorShopPhoto", fields: [shopPhotoId], references: [id], onDelete: SetNull)
  location        VendorLocation?
  serviceAreas    VendorServiceArea[]
  approvalHistory VendorApprovalHistory[]
  products        VendorProduct[]

  @@index([approvalStatus])
  @@map("vendor_profiles")
}

/// Where the business physically is. Radius service areas are measured from here.
model VendorLocation {
  id          String                                @id @default(uuid()) @db.Uuid
  vendorId    String                                @unique @map("vendor_id") @db.Uuid
  addressLine String                                @map("address_line") @db.VarChar(200)
  locality    String                                @db.VarChar(100)
  city        String                                @db.VarChar(80)
  district    String                                @db.VarChar(80)
  state       String                                @db.VarChar(80)
  pincode     String                                @db.Char(6)
  location    Unsupported("geography(Point, 4326)")
  createdAt   DateTime                              @default(now()) @map("created_at")
  updatedAt   DateTime                              @updatedAt @map("updated_at")

  vendor VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([location], type: Gist)
  @@index([pincode])
  @@map("vendor_locations")
}

/// Where the vendor sells. One RADIUS rule and any number of PINCODE / LOCALITY rules.
model VendorServiceArea {
  id           String          @id @default(uuid()) @db.Uuid
  vendorId     String          @map("vendor_id") @db.Uuid
  type         ServiceAreaType
  radiusMeters Int?            @map("radius_meters")
  pincode      String?         @db.Char(6)
  localityName String?         @map("locality_name") @db.VarChar(100)
  createdAt    DateTime        @default(now()) @map("created_at")

  vendor VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([pincode])
  @@index([localityName])
  @@map("vendor_service_areas")
}

model VendorApprovalHistory {
  id         String               @id @default(uuid()) @db.Uuid
  vendorId   String               @map("vendor_id") @db.Uuid
  fromStatus VendorApprovalStatus @map("from_status")
  toStatus   VendorApprovalStatus @map("to_status")
  adminId    String?              @map("admin_id") @db.Uuid
  note       String?              @db.VarChar(300)
  createdAt  DateTime             @default(now()) @map("created_at")

  vendor VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, createdAt])
  @@map("vendor_approval_history")
}

/// An uploaded image. Clients upload straight to storage with a presigned URL, then confirm.
model MediaAsset {
  id          String       @id @default(uuid()) @db.Uuid
  ownerUserId String       @map("owner_user_id") @db.Uuid
  purpose     MediaPurpose
  storageKey  String       @unique @map("storage_key") @db.VarChar(200)
  mimeType    String       @map("mime_type") @db.VarChar(40)
  sizeBytes   Int          @map("size_bytes")
  width       Int?
  height      Int?
  status      MediaStatus  @default(PENDING_UPLOAD)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  owner                User           @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  vendorProfilePhotoOf VendorProfile? @relation("VendorProfilePhoto")
  vendorShopPhotoOf    VendorProfile? @relation("VendorShopPhoto")
  productImageOf       VendorProduct?

  @@index([ownerUserId])
  @@map("media_assets")
}

/// Cache of India Post (api.postalpincode.in) results. The API has no coordinates;
/// `location` is filled later from GPS / reverse geocoding.
model PostOffice {
  id             String                                 @id @default(uuid()) @db.Uuid
  name           String                                 @db.VarChar(120)
  pincode        String                                 @db.Char(6)
  branchType     String?                                @map("branch_type") @db.VarChar(40)
  deliveryStatus String?                                @map("delivery_status") @db.VarChar(40)
  circle         String?                                @db.VarChar(80)
  district       String                                 @db.VarChar(80)
  division       String?                                @db.VarChar(80)
  region         String?                                @db.VarChar(80)
  state          String                                 @db.VarChar(80)
  country        String                                 @default("India") @db.VarChar(40)
  location       Unsupported("geography(Point, 4326)")?
  fetchedAt      DateTime                               @default(now()) @map("fetched_at")

  @@unique([name, pincode])
  @@index([pincode])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "post_offices_name_trgm_idx")
  @@map("post_offices")
}

/// Remembers which India Post queries were already made (PIN or lowercased branch name).
model PincodeLookup {
  key       String              @id @db.VarChar(120)
  status    PincodeLookupStatus
  fetchedAt DateTime            @default(now()) @map("fetched_at")

  @@map("pincode_lookups")
}

// ───────────────────────────── D3: catalogue, products, prices ─────────────────────────────

enum ModerationStatus {
  ACTIVE
  REMOVED_BY_ADMIN
}

model ProductCategory {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique @db.VarChar(40)
  nameEn    String   @map("name_en") @db.VarChar(60)
  nameHi    String   @map("name_hi") @db.VarChar(60)
  iconKey   String   @map("icon_key") @db.VarChar(40)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products VendorProduct[]

  @@map("product_categories")
}

model Unit {
  id        String @id @default(uuid()) @db.Uuid
  code      String @unique @db.VarChar(20)
  labelEn   String @map("label_en") @db.VarChar(30)
  labelHi   String @map("label_hi") @db.VarChar(30)
  sortOrder Int    @default(0) @map("sort_order")

  products VendorProduct[]

  @@map("units")
}

/// A vendor's own listing with its own price (integer paise).
model VendorProduct {
  id               String           @id @default(uuid()) @db.Uuid
  vendorId         String           @map("vendor_id") @db.Uuid
  categoryId       String           @map("category_id") @db.Uuid
  unitId           String           @map("unit_id") @db.Uuid
  name             String           @db.VarChar(80)
  description      String?          @db.VarChar(300)
  imageId          String?          @unique @map("image_id") @db.Uuid
  pricePaise       Int              @map("price_paise")
  isAvailable      Boolean          @default(true) @map("is_available")
  moderationStatus ModerationStatus @default(ACTIVE) @map("moderation_status")
  removedReason    String?          @map("removed_reason") @db.VarChar(300)
  deletedAt        DateTime?        @map("deleted_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  vendor   VendorProfile   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category ProductCategory @relation(fields: [categoryId], references: [id])
  unit     Unit            @relation(fields: [unitId], references: [id])
  image    MediaAsset?     @relation(fields: [imageId], references: [id], onDelete: SetNull)
  prices   PriceHistory[]

  @@index([vendorId])
  @@index([categoryId, isAvailable])
  @@map("vendor_products")
}

model PriceHistory {
  id              String   @id @default(uuid()) @db.Uuid
  vendorProductId String   @map("vendor_product_id") @db.Uuid
  oldPricePaise   Int      @map("old_price_paise")
  newPricePaise   Int      @map("new_price_paise")
  changedAt       DateTime @default(now()) @map("changed_at")

  product VendorProduct @relation(fields: [vendorProductId], references: [id], onDelete: Cascade)

  @@index([vendorProductId, changedAt])
  @@map("price_history")
}

// ───────────────────────────── D4: chat, calls, access, trust & safety ─────────────────────────────

enum ConversationStatus {
  OPEN
  BLOCKED
}

enum MessageType {
  TEXT
}

enum CommChannel {
  CHAT
  CALL
}

enum AccessSource {
  FREE_MVP
  PAID
  ADMIN_GRANT
}

enum ReportTarget {
  VENDOR
  PRODUCT
  USER
  MESSAGE
}

enum ReportReason {
  FAKE_VENDOR
  WRONG_PRICE
  BAD_QUALITY
  ABUSIVE
  SPAM
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

/// One thread per (customer, vendor) pair.
model Conversation {
  id                 String             @id @default(uuid()) @db.Uuid
  customerId         String             @map("customer_id") @db.Uuid
  vendorId           String             @map("vendor_id") @db.Uuid
  status             ConversationStatus @default(OPEN)
  blockedByUserId    String?            @map("blocked_by_user_id") @db.Uuid
  lastMessageAt      DateTime?          @map("last_message_at")
  lastMessagePreview String?            @map("last_message_preview") @db.VarChar(120)
  customerUnread     Int                @default(0) @map("customer_unread")
  vendorUnread       Int                @default(0) @map("vendor_unread")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  messages Message[]

  @@unique([customerId, vendorId])
  @@index([customerId, lastMessageAt])
  @@index([vendorId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id              String      @id @default(uuid()) @db.Uuid
  conversationId  String      @map("conversation_id") @db.Uuid
  senderUserId    String      @map("sender_user_id") @db.Uuid
  type            MessageType @default(TEXT)
  body            String      @db.VarChar(2000)
  /// Client-generated id that makes sending idempotent (retries never duplicate).
  clientMessageId String      @map("client_message_id") @db.VarChar(64)
  readAt          DateTime?   @map("read_at")
  createdAt       DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([senderUserId, clientMessageId])
  @@index([conversationId, createdAt(sort: Desc)])
  @@map("messages")
}

/// Records a customer tapping "Call" (the phone number reveal), not the call itself.
model CallLog {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  vendorId   String   @map("vendor_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([vendorId, createdAt])
  @@index([customerId, createdAt])
  @@map("call_logs")
}

/// Who may chat with / call whom. Granted as FREE_MVP today; PAID later without touching chat code.
model CommunicationAccess {
  id         String       @id @default(uuid()) @db.Uuid
  customerId String       @map("customer_id") @db.Uuid
  vendorId   String       @map("vendor_id") @db.Uuid
  channel    CommChannel
  source     AccessSource @default(FREE_MVP)
  paymentRef String?      @map("payment_ref") @db.VarChar(80)
  validUntil DateTime?    @map("valid_until")
  createdAt  DateTime     @default(now()) @map("created_at")

  @@unique([customerId, vendorId, channel])
  @@map("communication_access")
}

model Report {
  id                String       @id @default(uuid()) @db.Uuid
  reporterUserId    String       @map("reporter_user_id") @db.Uuid
  targetType        ReportTarget @map("target_type")
  targetId          String       @map("target_id") @db.Uuid
  reason            ReportReason
  details           String?      @db.VarChar(500)
  status            ReportStatus @default(OPEN)
  resolvedByAdminId String?      @map("resolved_by_admin_id") @db.Uuid
  resolutionNote    String?      @map("resolution_note") @db.VarChar(300)
  resolvedAt        DateTime?    @map("resolved_at")
  createdAt         DateTime     @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

model SupportTicket {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  subject   String       @db.VarChar(120)
  message   String       @db.VarChar(2000)
  status    TicketStatus @default(OPEN)
  adminNote String?      @map("admin_note") @db.VarChar(1000)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status, createdAt])
  @@map("support_tickets")
}
